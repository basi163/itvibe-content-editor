TELEGRAM_BOT_TOKEN=
QWEN_API_KEY=
# Copy the OpenAI-compatible base URL from your Model Studio workspace.
# Singapore example
# https://WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=
TRIAGE_MODEL=qwen3.8-flash
WRITER_MODEL=qwen3.7-plus

DATABASE_PATH=/app/data/editor.sqlite3
SOLIDOT_RSS_URL=https://www.solidot.org/index.rss
RSS_POLL_INTERVAL_SECONDS=300
RSS_OFFPEAK_POLL_INTERVAL_SECONDS=1800
# Local schedule, by default UTC+4 (Samara): poll frequently only in these windows.
RSS_ACTIVE_WINDOWS=05:00-23:00
RSS_SCHEDULE_UTC_OFFSET_HOURS=4
RSS_BOOTSTRAP_ITEMS=1
# Daily publication slots used by the "next slot" editorial action.
PUBLISH_SCHEDULE_SLOTS=09:00,12:00,15:00,18:00,21:00
PUBLISH_SCHEDULE_UTC_OFFSET_HOURS=4
MAX_POST_CHARS=2000
RELEVANCE_THRESHOLD=0.72
HTTP_TIMEOUT_SECONDS=25
MAX_SOURCE_LINKS=6
# Ordinary unpublished drafts are removed from SQLite after 30 days.
# Scheduled and published materials are always preserved; Telegram is untouched.
UNPUBLISHED_RETENTION_DAYS=30
DRAFT_CLEANUP_INTERVAL_SECONDS=86400

# Optional. These can also be selected later through /setup in the bot.
EDITOR_CHAT_ID=
TARGET_CHAT_ID=

# Optional Teletype publication target. Enter the account token only on the server.
TELETYPE_ACCESS_TOKEN=
TELETYPE_CLIENT_VERSION=4.41.26

# Optional Teletype -> VK crossposting. Keep the community token only on the server.
VK_COMMUNITY_ACCESS_TOKEN=
VK_COMMUNITY_GROUP_ID=
VK_API_VERSION=5.199
# Optional first-party VK web composer. The noVNC port is bound only to
# localhost on the server and should be opened through an SSH tunnel.
VK_BROWSER_WEBDRIVER_URL=http://vk-browser:4444/wd/hub
VK_BROWSER_TIMEOUT_SECONDS=45
